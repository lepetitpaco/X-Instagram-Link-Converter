{
  "manifest_version": 2,
  "name": "Embed Link Copier: X, Instagram, TikTok",
  "version": "1.2.1",
  "description": "Copy X, Instagram and TikTok links that embed well in Discord and chats (fixvx, vxtwitter, kkinstagram, tnktok…) in one click.",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "storage"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://x.com/*", "*://twitter.com/*"],
      "js": ["config.js", "utils.js", "storage.js", "content-x.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://www.instagram.com/*", "*://instagram.com/*"],
      "js": ["config.js", "utils.js", "storage.js", "content-instagram.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://www.tiktok.com/*", "*://tiktok.com/*"],
      "js": ["config.js", "utils.js", "storage.js", "content-tiktok.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Embed Link Copier",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{27ce2a46-7072-4e7e-8537-e7d0b8e4823f}",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
